# Adversary environment (repo root)
# Copy to `.env`:  cp .env.example .env
# Schema: packages/env/src/web.ts (@t3-oss/env-core + Zod)
#
# Vite and the Go API both load this root file in local development.
# apps/api/.env is an optional API-only override; exported process env always wins.
# Docker Compose also reads this file for web image build args.

# --- Development (Vite) — public basemaps; tiles stack not required ---
VITE_MAP_STYLE_LIGHT=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
VITE_MAP_STYLE_DARK=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
VITE_GEO_TILEJSON_URL=https://tiles.openfreemap.org/planet

# --- Local-first Docker / Traefik (fail-closed tileserver) ---
# Uncomment (or set) these before `pnpm run docker:build` / `docker:up`:
# VITE_MAP_STYLE_LIGHT=http://tiles.adversary/styles/liberty/style.json
# VITE_MAP_STYLE_DARK=http://tiles.adversary/styles/dark/style.json
# VITE_GEO_TILEJSON_URL=http://tiles.adversary/data/openmaptiles.json

# --- Web → Go API (TanStack Query cutover) ---
# Absolute URL for Docker/Traefik (cross-host; API CORS reflects Origin).
# Leave unset/empty for local Vite — requests proxy to localhost:8080 via vite.config.
# Local with proxy:        (omit or empty)
# Local direct:            VITE_API_BASE_URL=http://localhost:8080
# Docker / Traefik:        VITE_API_BASE_URL=http://api.adversary
# VITE_API_BASE_URL=http://localhost:8080

# --- Go API (apps/api) ---
# Used by docker compose (api / migrate / postgres) and local `go run`.
HTTP_ADDR=:8080
DATABASE_URL=postgres://adversary:adversary@localhost:5432/adversary?sslmode=disable
REDIS_URL=redis://localhost:6379/0
AUTH_MODE=off
# When AUTH_MODE=session: set Secure on the session cookie (use true behind HTTPS).
# AUTH_COOKIE_SECURE=false
# AUTH_SESSION_TTL=168h
MBTILES_PATH=./data/tiles/openmaptiles.mbtiles
# Runtime road/sea MVT (TileJSON). Empty → generate/route soft-fails surface tracks to synthetic.
GEO_TILEJSON_URL=https://tiles.openfreemap.org/planet
LOG_LEVEL=info
# Optional: unique per API replica for run leases (default: random UUID)
# INSTANCE_ID=api-1
POSTGRES_USER=adversary
POSTGRES_PASSWORD=adversary
POSTGRES_DB=adversary
