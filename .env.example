# Adversary environment (repo root)
# Copy to `.env`:  cp .env.example .env
# Schema: packages/env/src/web.ts (@t3-oss/env-core + Zod)
#
# Vite loads this file via apps/web `envDir` (monorepo root).
# Docker Compose also reads this file for web image build args.

# --- Development (Vite) — public basemaps; tiles stack not required ---
VITE_MAP_STYLE_LIGHT=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
VITE_MAP_STYLE_DARK=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# --- Local-first Docker / Traefik (fail-closed tileserver) ---
# Uncomment (or set) these before `pnpm run docker:build` / `docker:up`:
# VITE_MAP_STYLE_LIGHT=http://tiles.adversary/styles/liberty/style.json
# VITE_MAP_STYLE_DARK=http://tiles.adversary/styles/dark/style.json
